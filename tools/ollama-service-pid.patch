+      const command = execFileSync('ps', ['-p', String(pid), '-o', 'args='], options).trim()
+      return /^node(?:js)?$/i.test(path.basename(executable)) && command.endsWith(` ${paths.serverFile}`)
+    } catch {
+      if (!isRunning(pid)) return false
+      throw new Error(`Cannot verify whether PID ${pid} belongs to ${service.name}; no process was stopped.`)
